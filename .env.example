# Database Connection (SQLite local file or PostgreSQL connection URI)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Authentication
JWT_SECRET="your_production_secure_jwt_secret_key"

# OpenAI API Key for AI Intent Classification & Egyptian Dialect Responses
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# OpenAI Model Configuration
OPENAI_MODEL_LOW="gpt-4o-mini"
OPENAI_MODEL_HIGH="gpt-4o"

# WhatsApp Business Cloud API Credentials
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"
WHATSAPP_VERIFY_TOKEN="your_meta_webhook_verify_token"

# Email Provider Configuration ("RESEND" | "SMTP" | "LOG_ONLY")
EMAIL_PROVIDER="LOG_ONLY"
RESEND_API_KEY="re_your_resend_api_key"

# System App Mode & Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
