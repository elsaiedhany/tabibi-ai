datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Doctor {
  id                   String            @id @default(uuid())
  name                 String            // e.g. "د. أحمد محمد"
  title                String            // e.g. "استشاري الأمراض الجلدية والتناسلية وتجميل الجلد"
  specialty            String            // e.g. "جلدية وتجميل"
  subSpecialty         String?
  gender               String            @default("MALE") // "MALE", "FEMALE"
  photoUrl             String?
  bio                  String?           // Short professional bio
  experienceYears      Int               @default(12)
  qualifications       String?           // Certificates, memberships
  consultationPrice    Float             @default(500.0)
  followupPrice        Float             @default(300.0)
  whatsappNumber       String            @unique
  phone                String?
  email                String?
  workingHours         String            @default("السبت إلى الخميس: 4 م - 10 م")
  aiTone               String            @default("EGYPTIAN_FRIENDLY")
  aiName               String            @default("مريم")
  maxDailyAiBudget     Float             @default(10.0)
  maxAiCallsPerDay     Int               @default(200)
  googleCalendarId     String?
  googleCredentialsJson String?
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  users                DoctorUser[]
  locations            Location[]
  services             Service[]
  patients             Patient[]
  conversations        Conversation[]
  appointments         Appointment[]
  knowledgeBase        KnowledgeBase[]
  faqs                 FaqEntry[]
  reminders            Reminder[]
  settings             DoctorSettings?
  aiUsage              AiUsage[]
  analyticsEvents      AnalyticsEvent[]
  auditLogs            AuditLog[]
  applications         DoctorApplication[]
  subscriptions        Subscription[]

  @@map("doctors")
}

model Location {
  id            String   @id @default(uuid())
  doctorId      String
  name          String   // e.g. "فرع مدينة نصر"
  address       String   // e.g. "القاهرة، مدينة نصر، شارع الطيران"
  googleMapsUrl String?
  phone         String?
  workingHours  String?
  isPrimary     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  appointments Appointment[]

  @@index([doctorId])
  @@map("locations")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String
  role         String       @default("STAFF") // SUPER_ADMIN, DOCTOR, STAFF
  status       String       @default("ACTIVE") // ACTIVE, SUSPENDED, DISABLED
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  doctorUsers         DoctorUser[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  applications        DoctorApplication[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model DoctorApplication {
  id               String   @id @default(uuid())
  userId           String
  doctorId         String?
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  step             Int      @default(1)
  doctorData       String?  // JSON stringified step 1
  clinicData       String?  // JSON stringified step 2
  workingHoursData String?  // JSON stringified step 3
  servicesData     String?  // JSON stringified step 4
  rejectionReason  String?
  notes            String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedBy       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor           Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("doctor_applications")
}

model Subscription {
  id               String    @id @default(uuid())
  doctorId         String
  plan             String    @default("PRO") // STARTER, PRO, ENTERPRISE
  status           String    @default("ACTIVE") // PENDING, TRIAL, ACTIVE, SUSPENDED, EXPIRED, CANCELLED
  startDate        DateTime  @default(now())
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  doctor           Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([status])
  @@map("subscriptions")
}

model DoctorUser {
  id        String   @id @default(uuid())
  doctorId  String
  userId    String
  role      String   @default("STAFF")
  createdAt DateTime @default(now())

  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([doctorId, userId])
  @@map("doctor_users")
}

model Service {
  id             String        @id @default(uuid())
  doctorId       String
  name           String
  description    String?
  price          Float
  durationMinutes Int          @default(30)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  doctor         Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointments   Appointment[]

  @@index([doctorId])
  @@map("services")
}

model Patient {
  id             String         @id @default(uuid())
  doctorId       String
  whatsappNumber String
  name           String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  doctor         Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  appointments   Appointment[]

  @@unique([doctorId, whatsappNumber])
  @@index([doctorId])
  @@map("patients")
}

model Conversation {
  id               String            @id @default(uuid())
  doctorId         String
  patientId        String
  locationId       String?
  state            String            @default("IDLE")
  handoffStatus    String            @default("AI_ACTIVE") // AI_ACTIVE, HUMAN_ACTIVE, CLOSED
  currentServiceId String?
  selectedDate     String?
  selectedTime     String?
  lastIntent       String            @default("UNKNOWN")
  contextSummary   String?
  aiCallCount      Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  doctor           Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  location         Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  messages         Message[]
  aiUsages         AiUsage[]
  appointments     Appointment[]

  @@index([doctorId])
  @@index([patientId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  sender         String       // "PATIENT" | "BOT" | "HUMAN_AGENT"
  content        String
  normalizedText String?
  detectedIntent String?
  wasHandledByAi Boolean      @default(false)
  ruleMatched    String?
  mediaType      String?      // "text" | "audio" | "image" | "document"
  mediaUrl       String?
  status         String       @default("delivered") // "sent", "delivered", "read"
  whatsappId     String?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Appointment {
  id             String            @id @default(uuid())
  doctorId       String
  patientId      String
  serviceId      String
  locationId     String?
  conversationId String?
  date           String            // YYYY-MM-DD
  time           String            // HH:MM
  durationMinutes Int              @default(30)
  status         String            @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW, RESCHEDULED
  googleEventId  String?
  notes          String?
  reminderSent   Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  doctor         Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service        Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  location       Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  conversation   Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([doctorId])
  @@index([patientId])
  @@index([doctorId, date])
  @@index([doctorId, status])
  @@map("appointments")
}

model KnowledgeBase {
  id        String   @id @default(uuid())
  doctorId  String
  category  String   // e.g. "LOCATIONS", "PREPARATION", "POLICIES"
  title     String
  content   String
  tags      String?  // comma separated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("knowledge_base")
}

model FaqEntry {
  id             String   @id @default(uuid())
  doctorId       String
  question       String
  normalizedQ    String
  answer         String
  category       String?
  isAutoGenerated Boolean  @default(false)
  hitCount       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  doctor         Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("faq_entries")
}

model Reminder {
  id          String   @id @default(uuid())
  doctorId    String
  type        String   // "24H_BEFORE" | "2H_BEFORE" | "NO_SHOW" | "FOLLOWUP"
  hoursBefore Int      @default(24)
  templateText String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("reminders")
}

model DoctorSettings {
  id                     String   @id @default(uuid())
  doctorId               String   @unique
  isAiEnabled            Boolean  @default(true)
  whatsappAccessToken    String?
  whatsappPhoneNumberId  String?
  whatsappVerifyToken    String?
  greetingTemplate       String   @default("أهلاً بحضرتك 👋 أنا مريم، المساعدة الخاصة بـ {doctor_name}. إزاي أقدر أساعدك؟")
  workingHoursTemplate   String   @default("مواعيد د. {doctor_name}: {working_hours}.")
  bookingPromptTemplate  String   @default("تمام، اختار الميعاد المناسب لك:")
  cancellationTemplate   String   @default("تم إلغاء الموعد بنجاح.")
  handoffTemplate        String   @default("تمام، تم تحويل المحادثة لمساعد الاستقبال الخاص بالدكتور وسيقوم بالرد فوراً.")
  cancellationWindowHours Int     @default(4)
  updatedAt              DateTime @updatedAt

  doctor                 Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_settings")
}

model AiUsage {
  id             String       @id @default(uuid())
  doctorId       String
  conversationId String?
  model          String
  inputTokens    Int
  outputTokens   Int
  estimatedCost  Float
  reasonForCall  String
  complexity     String       @default("LOW")
  timestamp      DateTime     @default(now())

  doctor         Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([doctorId])
  @@map("ai_usage")
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  doctorId  String
  eventType String   // "RULE_HANDLED", "AI_HANDLED", "CACHE_HIT", "HANDOFF", "BOOKING_CREATED", "BOOKING_CANCELLED"
  metadata  String?  // JSON string
  timestamp DateTime @default(now())

  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("analytics_events")
}

model AuditLog {
  id        String   @id @default(uuid())
  doctorId  String?
  userId    String?
  action    String
  details   String?
  timestamp DateTime @default(now())

  doctor    Doctor?  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([doctorId])
  @@map("audit_logs")
}
